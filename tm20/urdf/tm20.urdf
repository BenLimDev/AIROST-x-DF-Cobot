<?xml version="1.0" encoding="utf-8"?>
<robot name="tm20">

  <ros2_control name="gz_ros2_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_2">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_3">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_4">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_5">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <link name="world" />
  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.04007 -0.03016 0.00037" rpy="0 0 0" />
      <mass value="1.886" />
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.005" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/base_link.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <inertial>
      <origin xyz="0.01897 0.09227 0" rpy="0 0 0" />
      <mass value="4.057" />
      <inertia ixx="0.016" ixy="0.0005" ixz="0" iyy="0.016" iyz="0" izz="0.020" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/link_1.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.1 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.2" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="-0.04007 -0.00037 0.01545" rpy="1.5708 0 -2.2375" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="0 1 0" />
    <limit lower="-4.71" upper="4.71" effort="100" velocity="10.0" />
  </joint>

  <link name="link_2">
    <inertial>
      <origin xyz="0 0.2641 -0.0656" rpy="0 0 0" />
      <mass value="11.25" />
      <inertia ixx="0.640" ixy="0" ixz="0" iyy="0.031" iyz="0.0001" izz="0.634" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/link_2.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.26 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.55" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_2" type="revolute">
    <origin xyz="0.18555 0.085 0" rpy="1.5708 -1.5658 -1.5708" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="0.1" />
  </joint>

  <link name="link_3">
    <inertial>
      <origin xyz="-0.17349 0.238 0" rpy="0 0 0" />
      <mass value="6.177" />
      <inertia ixx="0.221" ixy="0.02" ixz="0" iyy="0.014" iyz="0" izz="0.227" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/link_3.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.26 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.55" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_3" type="revolute">
    <origin xyz="0 0.6361 0" rpy="-1.5708 1.5312 -1.5797" />
    <parent link="link_2" />
    <child link="link_3" />
    <axis xyz="1 0 0" />
    <limit lower="-2.9" upper="2.9" effort="100" velocity="10.0" />
  </joint>

  <link name="link_4">
    <inertial>
      <origin xyz="0.066 -0.0037 0" rpy="0 0 0" />
      <mass value="0.84" />
      <inertia ixx="0.0014" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0016" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/link_4.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.15" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_4" type="revolute">
    <origin xyz="0 0.55558 0" rpy="3.1399 0 3.1416" />
    <parent link="link_3" />
    <child link="link_4" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10.0" />
  </joint>

  <link name="link_5">
    <inertial>
      <origin xyz="-0.08 0 0.055" rpy="0 0 0" />
      <mass value="1.58" />
      <inertia ixx="0.0048" ixy="0" ixz="0.0003" iyy="0.0051" iyz="0" izz="0.0016" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/link_5.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.15" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_5" type="revolute">
    <origin xyz="0.060207 0.058537 0" rpy="1.5672 0 -1.5708" />
    <parent link="link_4" />
    <child link="link_5" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10.0" />
  </joint>

  <link name="link_6">
    <inertial>
      <origin xyz="0 0 -0.013" rpy="0 0 0" />
      <mass value="0.044" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://tm20/meshes/link_6.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.09 0.025" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_6" type="fixed">
    <origin xyz="-0.012154 -0.0020165 0.12472" rpy="-0.0098957 -0.016364 1.5871" />
    <parent link="link_5" />
    <child link="link_6" />
    <axis xyz="0 0 1" />
    <limit lower="-6.28" upper="6.28" effort="50" velocity="10.0" />
  </joint>

  <gazebo reference="link_6">
    <sensor type="rgbd_camera" name="intel_d435">
      <pose>0 0 0 -1.5708 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <topic>camera/depth_image</topic>
      <camera>
        <horizontal_fov>1.50098</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>10.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>  
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>CONTROLLER_PARAMS_FILE</parameters>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>
</robot>